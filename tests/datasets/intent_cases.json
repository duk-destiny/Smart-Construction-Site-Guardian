{
 "suite": "intent_routing",
 "version": 1,
 "note": "IntentRouter 只读路由评测集;extract 级纯规则即判,db 级由评测脚本预置 3 张固定工单(最新序 1/2/3);use_llm=False 保证确定性",
 "seed_orders": [
  {
   "pos": 1,
   "status": "open",
   "created_at": "2030-01-03 00:00:00"
  },
  {
   "pos": 2,
   "status": "open",
   "created_at": "2030-01-02 00:00:00"
  },
  {
   "pos": 3,
   "status": "closed",
   "created_at": "2030-01-01 00:00:00"
  }
 ],
 "cases": [
  {
   "text": "帮我订个中午的外卖",
   "expected": {
    "action": "unknown"
   }
  },
  {
   "text": "今天天气怎么样",
   "expected": {
    "action": "unknown"
   }
  },
  {
   "text": "写一首关于安全的诗",
   "expected": {
    "action": "unknown"
   }
  },
  {
   "text": "整改中的还有几张单子",
   "expected": {
    "action": "order_list",
    "status": "open"
   }
  },
  {
   "text": "待验收的有多少",
   "expected": {
    "action": "order_list",
    "status": "submitted"
   }
  },
  {
   "text": "已经闭环的有几条",
   "expected": {
    "action": "order_detail",
    "order_pos": 3,
    "note": "唯一闭环单→单命中直达详情(消歧哲学)"
   }
  },
  {
   "text": "近7天有没有逾期的",
   "expected": {
    "action": "overdue_stats"
   }
  },
  {
   "text": "最近有超期的吗",
   "expected": {
    "action": "overdue_stats"
   }
  },
  {
   "text": "来一份安全周报",
   "expected": {
    "action": "weekly_stats",
    "days": 7
   }
  },
  {
   "text": "本周整体情况汇总一下",
   "expected": {
    "action": "weekly_stats",
    "days": 7
   }
  },
  {
   "text": "近30天隐患统计",
   "expected": {
    "action": "weekly_stats",
    "days": 30
   }
  },
  {
   "text": "过去两周的概况",
   "expected": {
    "action": "weekly_stats",
    "days": 14
   }
  },
  {
   "text": "1号工单怎么样了",
   "expected": {
    "action": "order_detail",
    "order_pos": 1
   }
  },
  {
   "text": "看看2号那单的进度",
   "expected": {
    "action": "order_detail",
    "order_pos": 2
   }
  },
  {
   "text": "#3工单处理到哪一步了",
   "expected": {
    "action": "order_detail",
    "order_pos": 3
   }
  },
  {
   "text": "3号工单的状态",
   "expected": {
    "action": "order_detail",
    "order_pos": 3
   }
  },
  {
   "text": "1号工单和3号工单都帮我看看",
   "expected": {
    "action": "confirm_list",
    "candidates": [
     1,
     3
    ]
   }
  },
  {
   "text": "2号工单、1号工单查询一下",
   "expected": {
    "action": "confirm_list",
    "candidates": [
     2,
     1
    ]
   }
  },
  {
   "text": "第2张单子什么情况",
   "expected": {
    "action": "order_detail",
    "order_pos": 2
   }
  },
  {
   "text": "查询一下最近整改中的单子有几张",
   "expected": {
    "action": "order_list",
    "status": "open"
   }
  },
  {
   "text": "统计一下逾期工单数量",
   "expected": {
    "action": "overdue_stats"
   }
  },
  {
   "text": "上周的安全周报给我一份",
   "expected": {
    "action": "weekly_stats",
    "days": 7
   }
  },
  {
   "text": "把待验收的列出来",
   "expected": {
    "action": "order_list",
    "status": "submitted"
   }
  },
  {
   "text": "逾期单还有几张啊",
   "expected": {
    "action": "overdue_stats"
   }
  },
  {
   "text": "近3天的安全数据统计一下",
   "expected": {
    "action": "weekly_stats",
    "days": 3
   }
  },
  {
   "text": "帮我看看最近一周整体情况",
   "expected": {
    "action": "weekly_stats",
    "days": 7
   }
  },
  {
   "text": "帮我查一下进度",
   "expected": {
    "action": "order_list",
    "status": null
   }
  },
  {
   "text": "1号单怎么样了",
   "expected": {
    "action": "order_detail",
    "order_pos": 1
   }
  },
  {
   "text": "多少张还没闭环",
   "expected": {
    "action": "order_list",
    "status": "open"
   }
  },
  {
   "text": "昨晚加班的考勤记录",
   "expected": {
    "action": "unknown"
   }
  }
 ]
}